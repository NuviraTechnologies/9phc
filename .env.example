# 9 PHC runs on YOUR OWN Meta Model API key. Copy this file to .env
# and put your key in it. .env is git-ignored; never share it.
# Get a key at https://dev.meta.ai
META_API_KEY=

# Optional: your contact address for the source registries' polite
# pools (Crossref and OpenAlex ask API callers to identify
# themselves). Use your own address — it goes out in those requests.
PHC_CONTACT_EMAIL=
